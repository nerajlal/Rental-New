{
    "name": "Jewelry Luxe",
    "version": "2.1.0",
    "author": "Metora",
    "description": "Premium jewelry rental theme with elegant design",
    "screenshot": "/images/themes/jewelry-luxe.jpg",
    "sections": [
        {
            "type": "header",
            "name": "Header",
            "icon": "fa-bars",
            "settings": {
                "logo_text": {
                    "type": "text",
                    "label": "Store Name",
                    "default": "Your Store"
                },
                "show_search": {
                    "type": "checkbox",
                    "label": "Show Search Bar",
                    "default": true
                }
            }
        },
        {
            "type": "hero",
            "name": "Hero Banner",
            "icon": "fa-image",
            "settings": {
                "heading": {
                    "type": "text",
                    "label": "Main Heading",
                    "default": "Premium Jewelry on Rent"
                },
                "subheading": {
                    "type": "textarea",
                    "label": "Subheading",
                    "default": "Exquisite designs for your special occasions"
                },
                "button_text": {
                    "type": "text",
                    "label": "Button Text",
                    "default": "Shop Now"
                },
                "button_url": {
                    "type": "text",
                    "label": "Button URL",
                    "default": "/shop"
                },
                "background_color": {
                    "type": "color",
                    "label": "Background Color",
                    "default": "#121212"
                }
            }
        },
        {
            "type": "featured-products",
            "name": "Featured Products",
            "icon": "fa-gem",
            "settings": {
                "heading": {
                    "type": "text",
                    "label": "Section Heading",
                    "default": "Featured Collection"
                },
                "subheading": {
                    "type": "text",
                    "label": "Subheading",
                    "default": "Discover our most popular jewelry pieces"
                },
                "products_count": {
                    "type": "number",
                    "label": "Number of Products",
                    "default": 4,
                    "min": 2,
                    "max": 8
                }
            }
        },
        {
            "type": "testimonials",
            "name": "Customer Testimonials",
            "icon": "fa-quote-left",
            "settings": {
                "heading": {
                    "type": "text",
                    "label": "Section Heading",
                    "default": "What Our Customers Say"
                },
                "show_ratings": {
                    "type": "checkbox",
                    "label": "Show Star Ratings",
                    "default": true
                }
            }
        },
        {
            "type": "how-it-works",
            "name": "How It Works",
            "icon": "fa-list-ol",
            "settings": {
                "heading": {
                    "type": "text",
                    "label": "Section Heading",
                    "default": "How It Works"
                },
                "step1_title": {
                    "type": "text",
                    "label": "Step 1 Title",
                    "default": "Choose"
                },
                "step1_desc": {
                    "type": "textarea",
                    "label": "Step 1 Description",
                    "default": "Browse our exclusive collection and pick your favorite."
                },
                "step2_title": {
                    "type": "text",
                    "label": "Step 2 Title",
                    "default": "Rent"
                },
                "step2_desc": {
                    "type": "textarea",
                    "label": "Step 2 Description",
                    "default": "Book for your dates and get it delivered to your doorstep."
                },
                "step3_title": {
                    "type": "text",
                    "label": "Step 3 Title",
                    "default": "Return"
                },
                "step3_desc": {
                    "type": "textarea",
                    "label": "Step 3 Description",
                    "default": "Look stunning! Then simply pack and return."
                }
            }
        },
        {
            "type": "cta",
            "name": "Call to Action",
            "icon": "fa-bullhorn",
            "settings": {
                "heading": {
                    "type": "text",
                    "label": "Heading",
                    "default": "Join our Exclusive Club"
                },
                "text": {
                    "type": "textarea",
                    "label": "Description",
                    "default": "Subscribe to get 20% off your first rental."
                },
                "button_text": {
                    "type": "text",
                    "label": "Button Text",
                    "default": "Subscribe"
                },
                "button_url": {
                    "type": "text",
                    "label": "Button URL",
                    "default": "#"
                },
                "background_color": {
                    "type": "color",
                    "label": "Background Color",
                    "default": "#f8f9fa"
                }
            }
        },
        {
            "type": "footer",
            "name": "Footer",
            "icon": "fa-copyright",
            "settings": {
                "description": {
                    "type": "textarea",
                    "label": "About Text",
                    "default": "Premium jewelry rental service for all your special occasions."
                },
                "email": {
                    "type": "text",
                    "label": "Email Address",
                    "default": "info@yourstore.com"
                },
                "phone": {
                    "type": "text",
                    "label": "Phone Number",
                    "default": "+1 234 567 8900"
                },
                "facebook_url": {
                    "type": "text",
                    "label": "Facebook URL",
                    "default": "#"
                },
                "instagram_url": {
                    "type": "text",
                    "label": "Instagram URL",
                    "default": "#"
                },
                "pinterest_url": {
                    "type": "text",
                    "label": "Pinterest URL",
                    "default": "#"
                },
                "copyright_text": {
                    "type": "text",
                    "label": "Copyright Text",
                    "default": "© 2026 All rights reserved"
                },
                "show_social": {
                    "type": "checkbox",
                    "label": "Show Social Media Links",
                    "default": true
                }
            }
        }
    ]
}