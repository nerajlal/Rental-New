{
    "name": "Jewelry Luxe",
    "version": "2.1.0",
    "author": "Metora",
    "description": "Premium jewelry rental theme with elegant design",
    "screenshot": "/images/themes/jewelry-luxe.jpg",
    "sections": [
        {
            "type": "header",
            "name": "Header",
            "icon": "fa-bars",
            "settings": {
                "logo_text": {
                    "type": "text",
                    "label": "Store Name",
                    "default": "Your Store"
                },
                "show_search": {
                    "type": "checkbox",
                    "label": "Show Search Bar",
                    "default": true
                }
            }
        },
        {
            "type": "hero",
            "name": "Hero Banner",
            "icon": "fa-image",
            "settings": {
                "autoplay_speed": {
                    "type": "text",
                    "label": "Autoplay Speed (ms)",
                    "default": "5000"
                },
                "slide1_image": {
                    "type": "text",
                    "label": "Slide 1 Image URL",
                    "default": ""
                },
                "slide1_heading": {
                    "type": "text",
                    "label": "Slide 1 Heading",
                    "default": "Premium Jewelry on Rent"
                },
                "slide1_subheading": {
                    "type": "textarea",
                    "label": "Slide 1 Subheading",
                    "default": "Exquisite designs for your special occasions"
                },
                "slide1_btn_text": {
                    "type": "text",
                    "label": "Slide 1 Button",
                    "default": "Shop Now"
                },
                "slide1_btn_url": {
                    "type": "text",
                    "label": "Slide 1 URL",
                    "default": "/shop"
                },
                "slide2_image": {
                    "type": "text",
                    "label": "Slide 2 Image URL",
                    "default": ""
                },
                "slide2_heading": {
                    "type": "text",
                    "label": "Slide 2 Heading",
                    "default": "Bridal Collection"
                },
                "slide2_subheading": {
                    "type": "textarea",
                    "label": "Slide 2 Subheading",
                    "default": "Make your wedding day unforgettable"
                },
                "slide2_btn_text": {
                    "type": "text",
                    "label": "Slide 2 Button",
                    "default": "View Collection"
                },
                "slide2_btn_url": {
                    "type": "text",
                    "label": "Slide 2 URL",
                    "default": "/shop/collection/bridal"
                },
                "slide3_image": {
                    "type": "text",
                    "label": "Slide 3 Image URL",
                    "default": ""
                },
                "slide3_heading": {
                    "type": "text",
                    "label": "Slide 3 Heading",
                    "default": "Diamond Sets"
                },
                "slide3_subheading": {
                    "type": "textarea",
                    "label": "Slide 3 Subheading",
                    "default": "Sparkle like a star with our real diamond sets"
                },
                "slide3_btn_text": {
                    "type": "text",
                    "label": "Slide 3 Button",
                    "default": "Rent Now"
                },
                "slide3_btn_url": {
                    "type": "text",
                    "label": "Slide 3 URL",
                    "default": "/shop/collection/diamond"
                }
            }
        },
        {
            "type": "featured-products",
            "name": "Featured Products",
            "icon": "fa-gem",
            "settings": {
                "heading": {
                    "type": "text",
                    "label": "Section Heading",
                    "default": "Featured Collection"
                },
                "subheading": {
                    "type": "text",
                    "label": "Subheading",
                    "default": "Discover our most popular jewelry pieces"
                },
                "products_count": {
                    "type": "number",
                    "label": "Number of Products",
                    "default": 4,
                    "min": 2,
                    "max": 8
                }
            }
        },
        {
            "type": "testimonials",
            "name": "Customer Testimonials",
            "icon": "fa-quote-left",
            "settings": {
                "heading": {
                    "type": "text",
                    "label": "Section Heading",
                    "default": "What Our Customers Say"
                },
                "show_ratings": {
                    "type": "checkbox",
                    "label": "Show Star Ratings",
                    "default": true
                },
                "t1_name": {
                    "type": "text",
                    "label": "Testimonial 1 Name",
                    "default": "Priya Sharma"
                },
                "t1_text": {
                    "type": "textarea",
                    "label": "Testimonial 1 Message",
                    "default": "Absolutely stunning jewelry! Made my wedding day extra special."
                },
                "t1_stars": {
                    "type": "number",
                    "label": "Testimonial 1 Stars (1-5)",
                    "default": 5
                },
                "t2_name": {
                    "type": "text",
                    "label": "Testimonial 2 Name",
                    "default": "Anjali Patel"
                },
                "t2_text": {
                    "type": "textarea",
                    "label": "Testimonial 2 Message",
                    "default": "Beautiful collection and amazing service. I rented bridal jewelry for my sister's wedding."
                },
                "t2_stars": {
                    "type": "number",
                    "label": "Testimonial 2 Stars (1-5)",
                    "default": 5
                },
                "t3_name": {
                    "type": "text",
                    "label": "Testimonial 3 Name",
                    "default": "Meera Reddy"
                },
                "t3_text": {
                    "type": "textarea",
                    "label": "Testimonial 3 Message",
                    "default": "Highly recommend! The jewelry pieces are exquisite and the team is very professional."
                },
                "t3_stars": {
                    "type": "number",
                    "label": "Testimonial 3 Stars (1-5)",
                    "default": 5
                }
            }
        },
        {
            "type": "how-it-works",
            "name": "How It Works",
            "icon": "fa-list-ol",
            "settings": {
                "heading": {
                    "type": "text",
                    "label": "Section Heading",
                    "default": "How It Works"
                },
                "step1_title": {
                    "type": "text",
                    "label": "Step 1 Title",
                    "default": "Choose"
                },
                "step1_desc": {
                    "type": "textarea",
                    "label": "Step 1 Description",
                    "default": "Browse our exclusive collection and pick your favorite."
                },
                "step2_title": {
                    "type": "text",
                    "label": "Step 2 Title",
                    "default": "Rent"
                },
                "step2_desc": {
                    "type": "textarea",
                    "label": "Step 2 Description",
                    "default": "Book for your dates and get it delivered to your doorstep."
                },
                "step3_title": {
                    "type": "text",
                    "label": "Step 3 Title",
                    "default": "Return"
                },
                "step3_desc": {
                    "type": "textarea",
                    "label": "Step 3 Description",
                    "default": "Look stunning! Then simply pack and return."
                }
            }
        },
        {
            "type": "cta",
            "name": "Call to Action",
            "icon": "fa-bullhorn",
            "settings": {
                "heading": {
                    "type": "text",
                    "label": "Heading",
                    "default": "Join our Exclusive Club"
                },
                "text": {
                    "type": "textarea",
                    "label": "Description",
                    "default": "Subscribe to get 20% off your first rental."
                },
                "button_text": {
                    "type": "text",
                    "label": "Button Text",
                    "default": "Subscribe"
                },
                "button_url": {
                    "type": "text",
                    "label": "Button URL",
                    "default": "#"
                },
                "background_color": {
                    "type": "color",
                    "label": "Background Color",
                    "default": "#f8f9fa"
                }
            }
        },
        {
            "type": "footer",
            "name": "Footer",
            "icon": "fa-copyright",
            "settings": {
                "description": {
                    "type": "textarea",
                    "label": "About Text",
                    "default": "Premium jewelry rental service for all your special occasions."
                },
                "email": {
                    "type": "text",
                    "label": "Email Address",
                    "default": "info@yourstore.com"
                },
                "phone": {
                    "type": "text",
                    "label": "Phone Number",
                    "default": "+1 234 567 8900"
                },
                "facebook_url": {
                    "type": "text",
                    "label": "Facebook URL",
                    "default": "#"
                },
                "instagram_url": {
                    "type": "text",
                    "label": "Instagram URL",
                    "default": "#"
                },
                "pinterest_url": {
                    "type": "text",
                    "label": "Pinterest URL",
                    "default": "#"
                },
                "show_social": {
                    "type": "checkbox",
                    "label": "Show Social Media Links",
                    "default": true
                }
            }
        }
    ]
}